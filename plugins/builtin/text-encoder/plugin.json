{
  "id": "com.quickdock.text-encoder",
  "name": "文本工具箱",
  "version": "0.2.0",
  "description": "Base64 / URL / HTML 编解码，MD5 / SHA256 哈希，Base64 图片识别预览",
  "author": "QuickDock",
  "icon": "icon.svg",
  "category": "开发者日常",
  "backend": {
    "runtime": "goja",
    "entry": "main.js"
  },
  "frontend": {
    "enabled": true,
    "entry": "frontend/index.html",
    "width": 620,
    "height": 520
  },
  "commands": [
    {
      "id": "base64-encode",
      "title": "Base64 编码",
      "keywords": [
        "base64",
        "encode"
      ],
      "aliases": [
        "base64编码"
      ],
      "prefix": "/b64e",
      "acceptsInput": true,
      "matchPattern": "[\\s\\S]+"
    },
    {
      "id": "base64-decode",
      "title": "Base64 解码",
      "keywords": [
        "base64",
        "decode"
      ],
      "aliases": [
        "base64解码"
      ],
      "prefix": "/b64d",
      "matchPattern": "^(data:image/[a-zA-Z0-9.+-]+;base64,)?[A-Za-z0-9+/]*={0,2}$",
      "acceptsInput": true
    },
    {
      "id": "url-encode",
      "title": "URL 编码",
      "prefix": "/urle",
      "acceptsInput": true,
      "matchPattern": "[\\s\\S]+"
    },
    {
      "id": "url-decode",
      "title": "URL 解码",
      "prefix": "/urld",
      "acceptsInput": true,
      "matchPattern": "[\\s\\S]+"
    },
    {
      "id": "html-encode",
      "title": "HTML 编码",
      "prefix": "/htmle",
      "acceptsInput": true,
      "matchPattern": "[\\s\\S]+"
    },
    {
      "id": "html-decode",
      "title": "HTML 解码",
      "prefix": "/htmld",
      "acceptsInput": true,
      "matchPattern": "[\\s\\S]+"
    },
    {
      "id": "md5-hash",
      "title": "MD5 哈希",
      "keywords": [
        "md5",
        "hash"
      ],
      "aliases": [
        "md5加密",
        "md5计算"
      ],
      "prefix": "/md5",
      "acceptsInput": true,
      "matchPattern": "[\\s\\S]+"
    },
    {
      "id": "sha256-hash",
      "title": "SHA256 哈希",
      "keywords": [
        "sha256",
        "hash"
      ],
      "aliases": [
        "sha256加密"
      ],
      "prefix": "/sha256",
      "acceptsInput": true,
      "matchPattern": "[\\s\\S]+"
    },
    {
      "id": "convert-case",
      "title": "变量命名转换",
      "keywords": [
        "case",
        "camel",
        "snake",
        "kebab",
        "pascal",
        "convert"
      ],
      "aliases": [
        "变量命名",
        "blmm",
        "命名转换",
        "驼峰",
        "下划线",
        "大小写"
      ],
      "matchPattern": "^[a-z]+[_-][a-z]+[a-z_0-9-]*$|^[a-z]+[A-Z][a-z]*[A-Za-z0-9]*$|^[A-Z][a-z]+[A-Z][a-z]*[A-Za-z0-9]*$|^[A-Z]+_[A-Z]+[A-Z_0-9]*$",
      "acceptsInput": true
    }
  ],
  "capabilities": [
    "command",
    "frontend"
  ],
  "permissions": {
    "clipboard": true
  }
}
